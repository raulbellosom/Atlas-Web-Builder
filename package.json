{
  "name": "@raulbellosom/atlas-web-builder",
  "version": "0.5.1",
  "description": "React-first, controlled website composer for Atlas ERP and reusable React projects.",
  "license": "MIT",
  "author": "raulbellosom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulbellosom/Atlas-Web-Builder.git"
  },
  "homepage": "https://github.com/raulbellosom/Atlas-Web-Builder#readme",
  "bugs": {
    "url": "https://github.com/raulbellosom/Atlas-Web-Builder/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/atlas-web-builder.cjs",
  "module": "./dist/atlas-web-builder.js",
  "exports": {
    ".": {
      "import": "./dist/atlas-web-builder.js",
      "require": "./dist/atlas-web-builder.cjs"
    },
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/contracts/WEBSITE_EDITOR_CAPABILITIES_V1.md",
    "docs/releases/0.3.5-provenance.md",
    "docs/releases/0.4.0-migration.md",
    "docs/releases/0.5.0-migration.md",
    "docs/releases/0.5.1-migration.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "playground:lan": "node scripts/playground-lan.mjs",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "immer": "^10.2.0",
    "lucide-react": "^1.65.0",
    "nanoid": "^5.1.16",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
